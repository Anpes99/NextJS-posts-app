# Postgres container (docker-compose.yml)
POSTGRES_USER=posts
POSTGRES_PASSWORD=posts
POSTGRES_DB=posts_app
POSTGRES_PORT=5432

# Prisma connection string. Keep it in sync with the values above.
DATABASE_URL="postgresql://posts:posts@localhost:5432/posts_app?schema=public"

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
